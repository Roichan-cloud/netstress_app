<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NETSTRESS"
            android:textColor="#00ffcc"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:shadowColor="#00ffcc"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM OFFLINE"
            android:textColor="#ff3333"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.2"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#222222"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <!-- PANEL 1: OTORISASI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 1. OTORISASI SISTEM ]"
                android:textColor="#00ffcc"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnShizuku"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="AKTIFKAN SHIZUKU"
                android:backgroundTint="#222222"
                android:textColor="#00ffcc"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PANEL 2: TARGET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 2. TARGET IP ]"
                android:textColor="#00ffcc"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etTargetIp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="192.168.1.x"
                android:textColor="#ffffff"
                android:textColorHint="#444444"
                android:fontFamily="monospace"
                android:backgroundTint="#00ffcc"
                android:inputType="text"
                android:paddingStart="10dp"/>
        </LinearLayout>

        <!-- PANEL 3: KONTROL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="2"
                android:text="MULAI\nSTRIKE"
                android:backgroundTint="#00ffcc"
                android:textColor="#000000"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="STOP"
                android:backgroundTint="#331111"
                android:textColor="#ff3333"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:enabled="false"/>
        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYS.VER 1.0 // LOCAL NETWORK STRESS TESTER"
            android:textColor="#444444"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
