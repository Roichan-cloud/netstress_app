<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0a"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETSTRESS"
        android:textColor="#00ffcc"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: OFFLINE"
        android:textColor="#ff3333"
        android:layout_marginTop="20dp"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btnShizuku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AKTIFKAN FITUR (SHIZUKU)"
        android:backgroundTint="#333333"
        android:textColor="#00ffcc"
        android:layout_marginTop="30dp" />

    <EditText
        android:id="@+id/etTargetIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan IP Target (192.168.1.x)"
        android:textColor="#ffffff"
        android:textColorHint="#888888"
        android:inputType="text"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MULAI STRIKE"
        android:backgroundTint="#00ffcc"
        android:textColor="#000000"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STOP"
        android:backgroundTint="#ff3333"
        android:textColor="#ffffff"
        android:layout_marginTop="10dp"
        android:enabled="false"/>

</LinearLayout>
